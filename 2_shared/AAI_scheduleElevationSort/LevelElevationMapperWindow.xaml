<Window x:Class="FRB.LevelElevationMapperWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Level Elevation Mapper" Width="400" Height="500" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- TITLE -->
        <TextBlock Grid.Row="0" Text="Level Elevation Mapper" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
        <!-- DOORS -->
        <GroupBox Grid.Row="1" Header="DOORS" Margin="0,0,0,10">
            <StackPanel Margin="10,5">
                <CheckBox x:Name="InternalDoorsCheckBox" Content="Internal Doors" Margin="0,3"/>
                <CheckBox x:Name="ExternalDoorsCheckBox" Content="External Doors" Margin="0,3"/>
            </StackPanel>
        </GroupBox>
        <!-- ROOMS -->
        <GroupBox Grid.Row="2" Header="ROOMS" Margin="0,0,0,10">
            <StackPanel Margin="10,5">
                <CheckBox x:Name="RoomsCheckBox" Content="Rooms" Margin="0,3"/>
            </StackPanel>
        </GroupBox>
        <!-- AREAS -->
        <GroupBox Grid.Row="3" Header="AREAS" Margin="0,0,0,10">
            <StackPanel Margin="10,5">
                <CheckBox x:Name="GrossInternalAreasCheckBox" Content="Gross Internal Areas (GIA)" Margin="0,3"/>
                <CheckBox x:Name="GrossExternalAreasCheckBox" Content="Gross External Areas (GEA)" Margin="0,3"/>
                <CheckBox x:Name="NetInternalAreasCheckBox" Content="Net Internal Areas (NIA)" Margin="0,3"/>
            </StackPanel>
        </GroupBox>
        <!-- OTHER ELEMENTS -->
        <GroupBox Grid.Row="4" Header="OTHER ELEMENTS" Margin="0,0,0,10">
            <StackPanel Margin="10,5">
                <CheckBox x:Name="SpecialtyEquipmentCheckBox" Content="Specialty Equipment" Margin="0,3"/>
            </StackPanel>
        </GroupBox>
        <!-- SELECTION BUTTONS -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,5,0,10">
            <Button Content="Select All" Width="100" Margin="0,0,5,0" Click="SelectAllButton_Click"/>
            <Button Content="Clear All" Width="100" Click="ClearAllButton_Click"/>
        </StackPanel>
        <!-- ACTION BUTTONS -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="85" Margin="0,0,5,0" IsCancel="True" Click="CancelButton_Click"/>
            <Button Content="Run" Width="85" IsDefault="True" Click="RunButton_Click"/>
        </StackPanel>
    </Grid>
</Window>